// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum para roles de usuário
enum UserRole {
  USER        // Usuário normal - acesso apenas ao app
  SUPER_USER  // Super usuário - acesso ao app e ao admin
}

// Modelo de Usuário
model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String
  password   String
  role       UserRole     @default(USER)
  /// Incrementado em refresh/rotação de senha — invalida tokens antigos
  sessionVersion Int        @default(0)
  /// Dados sociodemográficos e de saúde coletados no cadastro (JSON validado na API)
  profileRegistration Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  posts      Post[]       // Relação com posts
  questionarioRespostas QuestionarioResposta[] // Relação com respostas do questionário
  reflexoesTraco        ReflexaoTraco[]        // Reflexões dos traços SWOT
  diarioPaginas         DiarioPagina[]         // Páginas do diário da jornada SWOT
  diarioAutoadvocaciaQuinzenas DiarioAutoadvocaciaQuinzena[] // Quinzenas de autoadvocacia
}

// Modelo de Post
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text // HTML do editor TipTap
  imageUrl  String?  // URL da imagem de capa (opcional)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

// Página do diário da jornada SWOT (uma por traço, fechamento de quadrante ou reflexão final)
model DiarioPagina {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipo         String   // micro_traco | quadrante_final | forcas | jornada_final
  quadrante    String?  // ameaca | fraqueza | oportunidade | forca
  tipoTraco    String?  // SH | CH | FO | F
  numeroTraco  Int?
  tituloTraco  String?  @db.Text

  chave        String
  ordem        Int

  texto        String   @db.Text @default("")
  concluida    Boolean  @default(false)
  desbloqueada Boolean  @default(false)
  arquivada    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, chave])
  @@index([userId, ordem])
}

// Quinzena do diário de autoadvocacia
model DiarioAutoadvocaciaQuinzena {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  numero    Int
  rotulo    String?
  inicio    DateTime
  fim       DateTime

  resposta1 String   @db.Text @default("")
  resposta2 String   @db.Text @default("")
  concluida Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, numero])
  @@index([userId])
}

// Modelo de Fraquezas e Ameaças SH
model FraquezasAmeacasSh {
  id          String   @id @default(uuid())
  numeroTraco Int      // Número do traço
  pergunta    String   @db.Text // Pergunta
  explicacao  String   @db.Text // Explicação
  frequencia  Float    // Frequência
  intensidade Float    // Intensidade
  swot        String   @db.Text @default("")

  @@index([numeroTraco])
}

// Modelo Histórias sociais
model HistoriasSociais {
  id                  String   @id @default(uuid())
  numeroHistoria      Int      
  introducao          String   @db.Text 
  titulo              String   
  personagem          String   
  ambientacao         String   @db.Text 
  historia            String   @db.Text 
  questionamento      String   @db.Text 
  perguntaIntensidade String   @db.Text 
  intensidadeLeve     String   @db.Text 
  intensidadeModerada String   @db.Text 
  intensidadeAlta     String   @db.Text 

  @@index([numeroHistoria])
}

// Modelo de Fraquezas e Ameaças CH
model FraquezasAmeacasCh {
  id          String   @id @default(uuid())
  numeroTraco Int      
  numHistoria Int 
  frequencia  Float    
  intensidade Float    
  swot        String   @db.Text @default("")
  
  @@index([numeroTraco])
}

// Modelo de Fraquezas e Oportunidades 
model FraquezasOportunidades {
  id                String              @id @default(uuid())
  numeroTraco       Int
  pergunta          String              @db.Text
  explicacao        String              @db.Text
  swot              String              @db.Text @default("")

  tracoNeutro       TracoNeutroFO[]       @relation("TracoNeutroToFraquezasOportunidades")
  tracoOportunidade TracoOportunidadeFO[] @relation("TracoOportunidadeToFraquezasOportunidades")
  tracoFraqueza     TracoFraquezaFO[]     @relation("TracoFraquezaToFraquezasOportunidades")

  @@index([numeroTraco])
}

// Modelo de Traço Neutro - Fraquezas e Oportunidades 
model TracoNeutroFO {
  id                        String                 @id @default(uuid())
  valor                     String                 
  fraquezasOportunidadesId  String
  fraquezasOportunidades    FraquezasOportunidades @relation("TracoNeutroToFraquezasOportunidades", fields: [fraquezasOportunidadesId], references: [id], onDelete: Cascade)

  @@index([fraquezasOportunidadesId])
}

// Modelo de Traço Oportunidade - Fraquezas e Oportunidades 
model TracoOportunidadeFO {
  id                        String                 @id @default(uuid())
  valor                     String
  fraquezasOportunidadesId  String
  fraquezasOportunidades    FraquezasOportunidades @relation("TracoOportunidadeToFraquezasOportunidades", fields: [fraquezasOportunidadesId], references: [id], onDelete: Cascade)

  @@index([fraquezasOportunidadesId])
}

// Modelo de Traço Fraqueza - Fraquezas e Oportunidades 
model TracoFraquezaFO {
  id                        String                 @id @default(uuid())
  valor                     String
  fraquezasOportunidadesId  String
  fraquezasOportunidades    FraquezasOportunidades @relation("TracoFraquezaToFraquezasOportunidades", fields: [fraquezasOportunidadesId], references: [id], onDelete: Cascade)

  @@index([fraquezasOportunidadesId])
}

// Modelo de Forcas
model Forcas {
  id                String              @id @default(uuid())
  numeroTraco       Int
  pergunta          String              @db.Text
  exemplo           String              @db.Text
  swot              String              @db.Text @default("")

  tracoNeutro       TracoNeutroF[]       @relation("TracoNeutroToForcas")
  tracoForca        TracoForcaF[]        @relation("TracoForcaToForcas")
  tracoFraqueza     TracoFraquezaF[]     @relation("TracoFraquezaToForcas")
  tracoOportunidade TracoOportunidadeF[] @relation("TracoOportunidadeToForcas")

  @@index([numeroTraco])
}

// Modelo de Traço Neutro - Forcas
model TracoNeutroF {
  id        String  @id @default(uuid())
  valor     String
  forcasId  String
  forcas    Forcas  @relation("TracoNeutroToForcas", fields: [forcasId], references: [id], onDelete: Cascade)

  @@index([forcasId])
}

// Modelo de Traço Força - Forcas
model TracoForcaF {
  id        String  @id @default(uuid())
  valor     String
  forcasId  String
  forcas    Forcas  @relation("TracoForcaToForcas", fields: [forcasId], references: [id], onDelete: Cascade)

  @@index([forcasId])
}

// Modelo de Traço Fraqueza - Forcas
model TracoFraquezaF {
  id        String  @id @default(uuid())
  valor     String
  forcasId  String
  forcas    Forcas  @relation("TracoFraquezaToForcas", fields: [forcasId], references: [id], onDelete: Cascade)

  @@index([forcasId])
}

// Modelo de Traço Oportunidade - Forcas
model TracoOportunidadeF {
  id        String  @id @default(uuid())
  valor     String
  forcasId  String
  forcas    Forcas  @relation("TracoOportunidadeToForcas", fields: [forcasId], references: [id], onDelete: Cascade)

  @@index([forcasId])
}

// Modelo de Detalhes dos Traços (conteúdo editorial exibido no modal do app)
model TracoDetalhe {
  id          String   @id @default(uuid())
  tipo        String   // 'SH' | 'CH' | 'FO' | 'F'
  numeroTraco Int

  titulo      String

  // "O que é" — sempre exibido
  oQueE       Json     // String[]

  // Quando classificado como Força (tipo F, quadrante forca)
  comoUsarAcademico    String @db.Text @default("")
  comoUsarProfissional String @db.Text @default("")
  comoUsarCotidiano    String @db.Text @default("")

  // Quando classificado como Oportunidade (quadrante oportunidade, tipo FO)
  comoOportunidade Json // String[]
  exemplosOportunidadeAcademico      String @db.Text @default("")
  exemplosOportunidadeProfissional    String @db.Text @default("")
  exemplosOportunidadeFamiliar        String @db.Text @default("")
  exemplosOportunidadeAmigosColegas   String @db.Text @default("")
  exemplosOportunidadeParceiros       String @db.Text @default("")

  // Oportunidade em traços tipo F (Forças) — quadrante oportunidade
  exemplosPraticosEstudo    String @db.Text @default("")
  exemplosPraticosTrabalho  String @db.Text @default("")
  exemplosPraticosCotidiano String @db.Text @default("")

  // Quando classificado como Fraqueza (quadrante fraqueza, tipo FO)
  fraquezaOuAmeaca Json @default("[]") // String[] — parágrafos
  atrapalharAcademico      String @db.Text @default("")
  atrapalharProfissional    String @db.Text @default("")
  atrapalharFamiliar        String @db.Text @default("")
  atrapalharAmigosColegas   String @db.Text @default("")
  atrapalharParceiros       String @db.Text @default("")

  // Traços tipo F (Forças) — bullets por quadrante
  transformarEmForca        Json @default("[]") // String[] — quadrante oportunidade
  transformarEmOportunidade Json @default("[]") // String[] — quadrante fraqueza

  reduzirImpacto   Json // String[] — legado SH/CH embutido em TracoDetalhe

  // Neutro (tipo FO — sempre exibido)
  dicas      Json     // String[]
  exemplos   Json     // String[] — exemplos práticos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, numeroTraco])
  @@index([tipo])
}

// Relatório editorial — Traços de Fraquezas ou Ameaças sem história social (SH)
model RelatorioSh {
  id          String   @id @default(uuid())
  numeroTraco Int      @unique

  titulo      String

  oQueE       Json     // String[] — parágrafos descritivos

  atrapalharAcademico      String @db.Text @default("")
  atrapalharProfissional   String @db.Text @default("")
  atrapalharFamiliar       String @db.Text @default("")
  atrapalharAmigosColegas  String @db.Text @default("")
  atrapalharParceiros      String @db.Text @default("")

  reduzirImpacto Json     // String[] — parágrafos
  dicas          Json     // String[] — bullet points
  exemplos       Json     // String[] — bullet points

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numeroTraco])
}

// Relatório editorial — Traços de Fraquezas ou Ameaças com história social (CH)
model RelatorioCh {
  id          String   @id @default(uuid())
  numeroTraco Int      @unique

  titulo      String

  oQueE       Json     // String[] — parágrafos descritivos

  atrapalharAcademico      String @db.Text @default("")
  atrapalharProfissional   String @db.Text @default("")
  atrapalharFamiliar       String @db.Text @default("")
  atrapalharAmigosColegas  String @db.Text @default("")
  atrapalharParceiros      String @db.Text @default("")

  reduzirImpacto Json     // String[] — parágrafos
  dicas          Json     // String[] — bullet points
  exemplos       Json     // String[] — bullet points

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numeroTraco])
}

// Modelo de Reflexões do Usuário por Traço (persistência das respostas qualitativas)
model ReflexaoTraco {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipo        String  // 'SH' | 'CH' | 'FO' | 'F'
  numeroTraco Int
  quadrante   String  // 'ameaca' | 'fraqueza' | 'oportunidade' | 'forca'

  respostas   Json    // { q1?: string, q2?: string, ..., q8?: string }
  enviado     Boolean @default(false) // true = respostas enviadas; false = rascunho

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tipo, numeroTraco, quadrante])
  @@index([userId])
}

// Modelo de Resposta do Questionário SWOT
model QuestionarioResposta {
  id            String   @id @default(uuid())
  userId        String   // ID do usuário que respondeu
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Identificação da pergunta
  perguntaId    String   // ID da pergunta original (da tabela SH, CH, FO ou F)
  tipo          String   // Tipo da pergunta: 'SH', 'CH', 'FO', 'F'
  numeroTraco   Int      // Número do traço para referência
  
  // Respostas
  resposta      String?  // Resposta principal: 'sim', 'nao', 'neutro', 'forca', 'fraqueza', 'oportunidade'
  frequencia    Int?     // Frequência selecionada (1-5)
  intensidade   Int?     // Intensidade selecionada (1-3), apenas para SH e CH quando resposta é 'sim'
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, perguntaId, tipo]) // Um usuário só pode ter uma resposta por pergunta
  @@index([userId])
  @@index([userId, tipo])
  @@index([perguntaId])
}

model AppData {
  id                Int       @id @default(1)
  tcle              String    @db.Text
  termoUso          String    @default("") @db.Text
  bloquearAcesso    Boolean   @default(false)
  dataInicioAcesso  DateTime? @db.Date
  dataFimAcesso     DateTime? @db.Date
  emailsComAcesso   String[]  @default([])
  updatedAt         DateTime  @updatedAt
}

